# Compinance Environment Configuration
# GEMINI_API_KEY: Required for Gemini AI KYC forgery & biometric analysis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Hosting service URL
APP_URL="http://localhost:3000"

# PAWAPAY CONFIGURATION (Kenya Mobile Money / M-Pesa)
PAWAPAY_API_KEY="your_pawapay_live_or_sandbox_token"
PAWAPAY_ENVIRONMENT="sandbox" # "sandbox" or "production"
PAWAPAY_BASE_URL="https://api.sandbox.pawapay.cloud"
PAWAPAY_WEBHOOK_SECRET="pawapay_webhook_secret_key"
COMPANY_FLOAT_MIN_RESERVE_KES="50000"

# CLOUDFLARE R2 STORAGE (S3-compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="compinance-kyc-documents"
R2_PUBLIC_URL="https://r2.compinance.co.ke"

# ZEPTOMAIL (Transactional Email)
ZEPTOMAIL_API_TOKEN="zeptomail_api_token"
ZEPTOMAIL_SENDER_EMAIL="noreply@compinance.co.ke"
ZEPTOMAIL_SENDER_NAME="Compinance Loans"

# INFOBIP WHATSAPP (Conditional Kenya Mobile Notifications)
INFOBIP_WHATSAPP_ACTIVE="true" # "true" or "false"
INFOBIP_API_KEY="your_infobip_api_key"
INFOBIP_BASE_URL="https://your-domain.api.infobip.com"
INFOBIP_SENDER_NUMBER="254700000000"

# SECURITY & GEO-FENCING
ENFORCE_KENYA_GEO="true" # If true, rejects IPs outside KE or missing geo/VPN
JWT_ACCESS_SECRET="compinance_jwt_access_super_secret_key_32chars_min"
JWT_REFRESH_SECRET="compinance_jwt_refresh_super_secret_key_32chars_min"

# FIRESTORE (Google Cloud native)
# When deployed on Cloud Run, uses Application Default Credentials automatically.
GOOGLE_CLOUD_PROJECT="compinance-prod"
